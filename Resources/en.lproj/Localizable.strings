"developerMode.doc.title" = "Developer Mode Guide";
"developerMode.doc.overviewTitle" = "Overview";
"developerMode.doc.overviewBody" = "Developer Mode is a set of local, read-only, deterministic, and explainable analysis tools. When enabled, it provides access to task classification, storage optimization, local governance, and more. All data is processed locally and never uploaded to any server.";
"developerMode.doc.principleLocal" = "Local";
"developerMode.doc.principleReadonly" = "Read-Only";
"developerMode.doc.principleDeterministic" = "Deterministic";
"developerMode.doc.principleExplainable" = "Explainable";
"developerMode.doc.featuresTitle" = "Features";
"developerMode.doc.taskClassificationDesc" = "Classifies token usage data into categories: high reasoning, cache heavy, output dominant, high frequency, and high cost. Displayed in the model comparison section of the OpenCode detail page.";
"developerMode.doc.optimizeDesc" = "Scans for 5 types of issues: stale snapshots, excess backups, large session directories, config fragmentation, and stale latest snapshots. Results are shown in the local governance panel.";
"developerMode.doc.localGovernanceDesc" = "Displays file counts and access status for OpenCode config directory, Skills directory, and Session directory. Helps understand runtime configuration overview.";
"developerMode.doc.modelCompareDesc" = "Shows a cost allocation disclaimer at the bottom of the model comparison section in the OpenCode detail page, indicating how estimated values are calculated.";
"developerMode.doc.multiCurrencyDesc" = "Enables CNY/USD currency toggle in settings. All price displays switch dynamically with the selected currency.";
"developerMode.doc.aiAnalysisDesc" = "Sends anonymized data to an AI endpoint for optimization suggestions. Not yet available in this version.";
"developerMode.doc.comingSoon" = "Coming Soon";
"developerMode.doc.usageTitle" = "How to Use";
"developerMode.doc.usageStep1Title" = "Enable Developer Mode";
"developerMode.doc.usageStep1Detail" = "In the Developer Mode tab of Settings, turn on the \"Enable Developer Mode\" main toggle.";
"developerMode.doc.usageStep2Title" = "Enable Sub-Features";
"developerMode.doc.usageStep2Detail" = "Once the main toggle is on, you can independently control each sub-feature. Enable as needed.";
