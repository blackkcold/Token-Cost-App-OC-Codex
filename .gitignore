# Project local config
.memory/
.sisyphus/
.codex/

# Private sibling source staging - never commit the Relay server to Public App
/relay/

# Secrets - never commit private keys
*.pem
*.key
docs/*.pem

# Secrets - Android signing & relay credentials (global fallback, double insurance)
**/key.properties
**/*.jks
**/*.keystore
**/.env
**/.env.*
!**/.env.example
**/local.properties
relay/data/

# Tooling artifacts
.playwright-mcp/
/output/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# SPM / Xcode build
.build/
.build-codex/
.spm-build/
.spm-cache-*/
.spm-config-*/
.spm-security-*/
.module-cache-*/
.home-*/
.cache-*/
*.xcodeproj
xcuserdata/

# IDE
.idea/
.vscode/

# Release artifacts (binaries generated locally; zips uploaded via GitHub Releases)
# Binaries live in the workspace-level App-Builds/ directory, laid out as
# App-Builds/<version>/{macos,android}, App-Builds/<timestamped-version>/<platform>,
# App-Builds/qa/<qa-pack>, and App-Builds/latest/<platform>.
# Locally App-Builds/ is a workspace sibling outside this repo; in CI it is placed at
# $GITHUB_WORKSPACE/App-Builds (inside the checkout), so ignore it here too.
/App-Builds/
# This repo's release/ directory only keeps metadata (versions.json); ignore any stray binaries.
release/latest/*.app
release/latest/*.zip
release/latest/*.dmg
release/v*.*.*/*.app
release/v*.*.*/*.zip
release/v*.*.*/*.dmg
release/v*.*.*-*/*.app
release/v*.*.*-*/*.zip
release/v*.*.*-*/*.dmg
release/release-notes/

# Local dev build info (regenerates on every build; not tracked remotely)
release/latest/BUILD_INFO.txt

# Extracted provider logo source archive (contents live in Resources/ProviderLogos/)
docs/five_logos_svg.zip

# Keep these release metadata files
!release/versions.json
!release/.gitkeep
!release/latest/.gitkeep

# Android release artifacts (binaries generated by script/build_android_release.sh;
# uploaded via GitHub Releases, never committed). Release binaries now land in the
# workspace-level App-Builds/<version>/android/ directory (outside this repo); these
# rules only guard any legacy android/release/ leftovers.
android/release/**/*.apk
android/release/**/*.aab
android/release/**/*.zip

# Deprecated app/ build caches (will be removed)
app/.build/
app/.build-codex/
app/.spm-cache-codex/
app/.spm-config-codex/
app/.spm-security-codex/
app/.module-cache-codex/
app/.home-codex/
app/.cache-codex/
